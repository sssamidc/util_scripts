[Unit]
Description=Bluetooth Sound Alert Service
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 10
ExecStart=/etc/systemd/manualalert.sh
StandardOutput=append:/opt/ati/ps4_manualalert.log
StandardError=append:/opt/ati/ps4_manualalert.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target 
